# Copy to .env for local development. NEVER commit the real .env.
# On Railway, set these in the service's Variables tab instead.

# development | production  (production disables /docs and /openapi.json)
APP_ENV=production

# Brevo SMTP (Brevo dashboard -> SMTP & API -> SMTP). The login is NOT your account email.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_TIMEOUT_SECONDS=10

# Must be a sender you have verified in Brevo (Senders, Domains & Dedicated IPs)
MAIL_FROM=verified-sender@example.com
MAIL_FROM_NAME=Portfolio Contact Form
# Where enquiries are delivered
CONTACT_RECEIVER_EMAIL=you@example.com

# Exact browser origin(s) allowed to call the API, comma separated, no trailing slash, no "*"
FRONTEND_ORIGIN=https://your-portfolio-domain.example

# Rate limiting (slowapi syntax; separate several limits with ";"). Applied per client IP.
RATE_LIMIT_CONTACT=2/minute;5/hour
# Optional shared store for multi-instance deployments, e.g. redis://default:password@host:6379
RATE_LIMIT_STORAGE_URI=memory://
# true only behind a trusted reverse proxy (Railway): use the last X-Forwarded-For hop as client IP
TRUST_PROXY=true
