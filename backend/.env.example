# Copy to .env for local development. NEVER commit the real .env.
# On Railway, set these in the service's Variables tab instead.

# development | test | production. Production refuses to start with unsafe values (see app/core/config.py).
APP_ENV=production

# --- required -----------------------------------------------------------------
# 32+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs session tokens and seals 2FA secrets. Changing it signs everyone out and invalidates enrolled 2FA.
SECRET_KEY=
# Railway Postgres provides this as ${{Postgres.DATABASE_URL}}; postgres:// URLs are accepted.
DATABASE_URL=
# The public website origin (your Vercel domain), https in production, no trailing slash.
PUBLIC_SITE_ORIGIN=https://your-portfolio.vercel.app
# Extra origins allowed to call public endpoints cross-origin (comma separated, never "*"). Usually empty.
FRONTEND_ORIGIN=
COOKIE_SECURE=true

# Number of proxies that append to X-Forwarded-For in front of the API.
# Browser -> Vercel rewrite -> Railway  =>  2.   Direct to Railway  =>  1.
TRUSTED_PROXY_HOPS=2

# --- media (required in production) -------------------------------------------
STORAGE_BACKEND=cloudinary
# Cloudinary dashboard -> API Keys -> "API environment variable"
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=portfolio
MAX_IMAGE_MB=5
MAX_DOCUMENT_MB=10

# --- email (Brevo SMTP or any SMTP relay) -------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=verified-sender@your-domain.com
MAIL_FROM_NAME=Dileep Kumar Panchumarthi
# Where new-enquiry notifications go
CONTACT_RECEIVER_EMAIL=you@your-domain.com
# Send a short "thanks, I received your enquiry" email to the visitor
SEND_LEAD_ACKNOWLEDGEMENT=true

# --- abuse protection ----------------------------------------------------------
RATE_LIMIT_CONTACT=3/minute;10/hour
RATE_LIMIT_LOGIN=10/minute;50/hour
# memory:// is per-instance. For more than one instance use redis://default:password@host:6379
RATE_LIMIT_STORAGE_URI=memory://
# Optional Cloudflare Turnstile secret. When set, the contact API requires a valid token.
TURNSTILE_SECRET_KEY=
MIN_FORM_FILL_MS=2500

# --- sessions (defaults are sensible) -------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REAUTH_WINDOW_MINUTES=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
