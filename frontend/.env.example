# Frontend environment (Vite). Anything prefixed VITE_ is bundled into the public
# JavaScript, so NEVER put secrets here. SMTP credentials belong in backend/.env only.

# Base URL of the FastAPI contact backend, no trailing slash.
# Local dev default (if unset): http://localhost:8000
# Production example: https://your-service.up.railway.app
VITE_API_URL=
